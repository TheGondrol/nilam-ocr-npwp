# Wajib. Key yang harus dikirim client (orchestrator) lewat header X-API-Key.
# (MOCK_API_KEY juga diterima, supaya .env dari mock ocr-npwp bisa dipakai apa adanya.)
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme

# Opsional: hanya mempengaruhi field 'servers' di OpenAPI (/docs).
# SERVICE_BASE_URL=http://your-vm-ip:8030

# PORT=8030

# Opsional. Diisi -> status request_id disimpan di PostgreSQL (jalankan
# db/schema.sql dulu, lihat README "Database"). Kosong -> in-memory seperti mock.
# DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/bribrain_ocr_nilam
# LOG_LEVEL=INFO

# Backend (adapter) yang dipakai tiap app. Lihat README bagian "Mengganti Mock dengan Model Asli".
# GUARDRAILS_BACKEND=mock
# EKSTRAKSI_BACKEND=mock
# STRUCTURING_BACKEND=rule_based
# SCORING_BACKEND=heuristic

# Folder tempat file bobot model (ONNX/PyTorch, dll) diletakkan.
# WEIGHTS_DIR=weights

# Ambang batas kebijakan (policy) — bukan bagian dari model, murni aturan bisnis.
# GUARDRAILS_MIN_QUALITY_SCORE=0.5
# GUARDRAILS_EXPECTED_DOCUMENT_TYPE=npwp
# GUARDRAILS_MIN_CLASSIFICATION_CONFIDENCE=0.7
# SCORING_APPROVE_THRESHOLD=0.8
# SCORING_REVIEW_THRESHOLD=0.5

# Batas upload.
# MAX_UPLOAD_BYTES=5242880
# ALLOWED_CONTENT_TYPES=["image/jpeg","image/jpg","image/png"]
