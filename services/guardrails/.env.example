API_KEY=changeme

ENVIRONMENT=local
# AUTH_DISABLED=false

# SERVICE_BASE_URL=http://your-vm-ip:8031
# PORT=8031

GUARDRAILS_BACKEND=efficientnet

GUARDRAILS_MODEL_PATH=weights/best_model.pt
GUARDRAILS_DEVICE=cpu
# GUARDRAILS_TORCH_THREADS=2

# GUARDRAILS_BACKEND=remote
# GUARDRAILS_MODEL_URL=http://localhost:8081
# GUARDRAILS_MODEL_API_KEY=dummy-key
# GUARDRAILS_MODEL_TIMEOUT_SECONDS=30

# Default ambang reject (kosong = dari checkpoint, 0.5). Ambang dari Orkestrasi pusat didahulukan.
# GUARDRAILS_REJECT_THRESHOLD=
# Ambang reject milik Orkestrasi pusat. Endpoint aslinya belum ada; dummy-nya di tracker:
# GUARDRAILS_THRESHOLD_URL=http://127.0.0.1:8090
# GUARDRAILS_THRESHOLD_PATH=/v1/thresholds/guardrails
# GUARDRAILS_THRESHOLD_API_KEY=
# GUARDRAILS_THRESHOLD_TIMEOUT_SECONDS=2
# GUARDRAILS_THRESHOLD_CACHE_SECONDS=60
# GUARDRAILS_DOCUMENT_POLICY=all
# GUARDRAILS_PDF_DPI=150
# GUARDRAILS_MAX_PAGES=20
# Dokumen NPWP maksimal 2 halaman; lebih dari itu ditolak 400 sebelum model jalan.
# GUARDRAILS_MAX_DOCUMENT_PAGES=2

# Batas ukuran dokumen (default 2,5 MB); lebih besar ditolak 413.
# MAX_UPLOAD_BYTES=2621440
# FILE_URL_ALLOWED_HOSTS=minio.example.internal,.storage.example.com
# ALLOWED_CONTENT_TYPES=["image/jpeg","image/jpg","image/png","application/pdf"]
