# Wajib. Key yang harus dikirim pemanggil (orkestrator / service ekstraksi) lewat header X-API-Key.
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme

# Opsional: hanya mempengaruhi field 'servers' di OpenAPI (/docs).
# SERVICE_BASE_URL=http://your-vm-ip:8031
# PORT=8031

# Backend model:
#   efficientnet  checkpoint EfficientNet-B0 di proses ini
#   remote        service model guardrails milik ML engineer (POST {url}/v1/predict/json)
#   mock          vonis dari nama file, untuk test
GUARDRAILS_BACKEND=efficientnet

# --- Backend efficientnet ---
# Bobot: taruh best_model.pt di services/guardrails/weights/; saat build Docker
# file itu ikut ke dalam image (COPY), jadi container tidak butuh volume.
GUARDRAILS_MODEL_PATH=weights/best_model.pt
# Inference CPU saja (wheel torch CPU). Batasi thread kalau container diberi limit CPU.
GUARDRAILS_DEVICE=cpu
# GUARDRAILS_TORCH_THREADS=2

# --- Backend remote ---
# URL wajib. API key dikirim ke SERVICE MODEL sebagai X-API-Key (beda dengan
# API_KEY di atas, yang dikirim pemanggil ke service ini). Dari dalam container,
# service di host dijangkau lewat host.docker.internal, bukan localhost.
# GUARDRAILS_BACKEND=remote
# GUARDRAILS_MODEL_URL=http://localhost:8081
# GUARDRAILS_MODEL_API_KEY=dummy-key
# GUARDRAILS_MODEL_TIMEOUT_SECONDS=30

# Ambang batas & kebijakan: HANYA backend lokal (efficientnet, mock). Dengan
# `remote`, vonis halaman dan dokumen diputuskan service model.
# Kosong = pakai reject_threshold dari checkpoint (0.5).
# GUARDRAILS_REJECT_THRESHOLD=
# all = accepted hanya kalau semua halaman accepted; majority = accepted > reject.
# GUARDRAILS_DOCUMENT_POLICY=all
# GUARDRAILS_PDF_DPI=150
# GUARDRAILS_MAX_PAGES=20

# Batas upload.
# MAX_UPLOAD_BYTES=5242880
# ALLOWED_CONTENT_TYPES=["image/jpeg","image/jpg","image/png","application/pdf"]
