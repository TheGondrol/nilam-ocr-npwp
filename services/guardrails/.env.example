API_KEY=changeme

ENVIRONMENT=local
# AUTH_DISABLED=false

# SERVICE_BASE_URL=http://your-vm-ip:8031
# PORT=8031

GUARDRAILS_BACKEND=efficientnet

GUARDRAILS_MODEL_PATH=weights/best_model.pt
GUARDRAILS_DEVICE=cpu
# GUARDRAILS_TORCH_THREADS=2

# GUARDRAILS_BACKEND=remote
# GUARDRAILS_MODEL_URL=http://localhost:8081
# GUARDRAILS_MODEL_API_KEY=dummy-key
# GUARDRAILS_MODEL_TIMEOUT_SECONDS=30

# Default ambang, pada probabilitas accepted: halaman lolos kalau proba_approve >= ambang (kosong = dari
# checkpoint, 0.5). Ambang dari Orkestrasi pusat didahulukan.
# GUARDRAILS_THRESHOLD=
# Ambang milik Orkestrasi pusat: {"threshold": 0.6}.
# Endpoint aslinya belum ada; dummy-nya di tracker:
# GUARDRAILS_THRESHOLD_URL=http://127.0.0.1:8090
# GUARDRAILS_THRESHOLD_PATH=/v1/thresholds/guardrails
# GUARDRAILS_THRESHOLD_API_KEY=
# GUARDRAILS_THRESHOLD_TIMEOUT_SECONDS=2
# GUARDRAILS_THRESHOLD_CACHE_SECONDS=60
# GUARDRAILS_DOCUMENT_POLICY=all
# GUARDRAILS_PDF_DPI=150
# GUARDRAILS_MAX_PAGES=20

# Tipe, ukuran (413), dan jumlah halaman dicek orchestrator sebelum guardrails dipanggil. MAX_UPLOAD_BYTES di
# sini hanya membatasi unduhan file_url.
# MAX_UPLOAD_BYTES=2621440
# FILE_URL_ALLOWED_HOSTS=minio.example.internal,.storage.example.com
# ALLOWED_CONTENT_TYPES=["image/jpeg","image/jpg","image/png","application/pdf"]

# Elastic APM: kosong = mati (agen tidak dimuat). Token ATAU API key, sesuai server APM-nya.
# ELASTIC_APM_SERVER_URL=https://apm.example:8200
# ELASTIC_APM_SECRET_TOKEN=
# ELASTIC_APM_API_KEY=
# ELASTIC_APM_ENVIRONMENT=local
# ELASTIC_APM_TRANSACTION_SAMPLE_RATE=1.0

# Model dari GCS (diunduh saat start ke MODELS_DIR, default /tmp/models) alih-alih file lokal. Model baru diunggah
# menimpa objeknya; pod mengambilnya saat restart. SHA-256 opsional (tanpa itu dicek dengan SHA-256 saat unggah).
# Kredensial: variabel AZURE_* / GCP_* dari wif.gcs.env (Tim SEA). Kosong = file lokal GUARDRAILS_MODEL_PATH.
# GUARDRAILS_MODEL_GCS_URI=gs://gc-bribrain-dev-gcs-ocr-nilam-01/nilam-ocr-npwp/guardrails/best_model.pt
# GUARDRAILS_MODEL_SHA256=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# GCP_PROJECT_NUMBER=
# GCP_POOL_ID=
# GCP_PROVIDER_ID=
# GCP_SERVICE_ACCOUNT_EMAIL=
