# Wajib. Key yang harus dikirim pemanggil (service ekstraksi) lewat header X-API-Key.
# Juga dipakai service ini saat memanggil scoring dan Orkestrasi, kecuali *_API_KEY diisi.
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme
# Dev saja: true = pemeriksaan X-API-Key dimatikan (service mencatat peringatan).
# AUTH_DISABLED=false

# Opsional: hanya mempengaruhi field 'servers' di OpenAPI (/docs).
# SERVICE_BASE_URL=http://your-vm-ip:8032
# PORT=8032

# Backend structurer (rule_based sampai model LLM/layout tersedia).
# STRUCTURING_BACKEND=rule_based

# --- Pipeline async (/v1/structuring/jobs) ---
# Diisi -> structuring.jobs / structuring.results di PostgreSQL (jalankan
# db/schema.sql dulu). Kosong -> in-memory: cukup untuk dev satu proses, hilang
# saat restart, tidak idempoten antar replika.
# DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/bribrain_ocr_nilam

# Callback status tahap ke Orkestrasi: POST {ORCHESTRATION_URL}{ORCHESTRATION_CALLBACK_PATH}
# dengan body {request_id, stage, status, result, error_message}. URL kosong -> callback dilewati.
# ORCHESTRATION_API_KEY kosong = pakai API_KEY di atas.
# ORCHESTRATION_URL=http://host.docker.internal:8000
# ORCHESTRATION_CALLBACK_PATH=/v1/callbacks/stage
# ORCHESTRATION_API_KEY=
# ORCHESTRATION_TIMEOUT_SECONDS=10

# Tahap berikutnya (scoring). SCORING_API_KEY kosong = pakai API_KEY di atas.
# Menjalankan bare di host: 127.0.0.1:<port>. Di compose sudah di-override ke nama service.
SCORING_SERVICE_URL=http://127.0.0.1:8033
# SCORING_API_KEY=
# SCORING_TIMEOUT_SECONDS=10

# Callback dan handoff dicoba ulang kalau tujuan tidak terjangkau / 5xx.
# PIPELINE_RETRY_ATTEMPTS=3
# PIPELINE_RETRY_DELAY_SECONDS=0.5
# PIPELINE_DRAIN_TIMEOUT_SECONDS=30
