API_KEY=changeme

ENVIRONMENT=local
# AUTH_DISABLED=false

# SERVICE_BASE_URL=http://your-vm-ip:8032
# PORT=8032

# STRUCTURING_BACKEND=npwp_rules
# Data rujukan aturan ML engineer (opsional; file yang tidak ada = pemeriksaan itu tanpa sinyal).
# Default: nama file yang sama di app/vendor/npwp_rules/data/.
# WILAYAH_CODES_PATH=app/vendor/npwp_rules/data/kode_wilayah_v2.json
# KPP_CODES_PATH=app/vendor/npwp_rules/data/kpp_codes_v2.json
# NAME_MASTER_PATH=app/vendor/npwp_rules/data/name_lnmast.xlsx

# DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/bribrain_ocr_nilam

# ORCHESTRATION_URL=http://host.docker.internal:8000
# ORCHESTRATION_CALLBACK_PATH=/v1/callbacks/stage
# ORCHESTRATION_CALLBACK_ENABLED=true
# ORCHESTRATION_CALLBACK_MAX_AGE_SECONDS=600
# ORCHESTRATION_API_KEY=
# ORCHESTRATION_TIMEOUT_SECONDS=10

SCORING_SERVICE_URL=http://127.0.0.1:8033
# SCORING_API_KEY=
# SCORING_TIMEOUT_SECONDS=10

# PIPELINE_RETRY_ATTEMPTS=3
# PIPELINE_RETRY_DELAY_SECONDS=0.5
# PIPELINE_DRAIN_TIMEOUT_SECONDS=30

# Elastic APM: kosong = mati (agen tidak dimuat). Token ATAU API key, sesuai server APM-nya.
# ELASTIC_APM_SERVER_URL=https://apm.example:8200
# ELASTIC_APM_SECRET_TOKEN=
# ELASTIC_APM_API_KEY=
# ELASTIC_APM_ENVIRONMENT=local
# ELASTIC_APM_TRANSACTION_SAMPLE_RATE=1.0
# ELASTIC_APM_SANITIZE_FIELD_NAMES=password,passwd,pwd,secret,key,*token,session,credit,card,auth,principal,set-cookie,signature,credential
