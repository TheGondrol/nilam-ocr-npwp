# Wajib. Key yang harus dikirim client (orkestrator) lewat header X-API-Key.
# (MOCK_API_KEY juga diterima, supaya .env dari mock ocr-npwp bisa dipakai apa adanya.)
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme

# local | dev | staging | production. local = laptop; tiga lainnya = ter-deploy,
# pengaman aktif. DEFAULT-nya production: tanpa baris ini service
# menolak start kalau AUTH_DISABLED=true, backend mock, DATABASE_URL /
# ORCHESTRATION_URL kosong, atau alamat service masih localhost. Di GKE nilainya
# datang dari ConfigMap (deploy/k8s), bukan dari file ini.
ENVIRONMENT=local
# Dev saja: true = pemeriksaan X-API-Key dimatikan (service mencatat peringatan).
# AUTH_DISABLED=false

# Opsional: hanya mempengaruhi field 'servers' di OpenAPI (/docs).
# SERVICE_BASE_URL=http://your-vm-ip:8030
# PORT=8030

# Diisi -> ocr.jobs / ocr.results (pipeline async) dan ocr_npwp_requests (kontrak
# lama) di PostgreSQL (jalankan db/schema.sql dulu, lihat README "Database").
# Kosong -> in-memory: cukup untuk dev satu proses, hilang saat restart, tidak
# idempoten antar replika.
# DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/bribrain_ocr_nilam

# --- Pipeline async (/v1/ekstraksi/jobs) ---
# Callback status tahap ke Orkestrasi: POST {ORCHESTRATION_URL}{ORCHESTRATION_CALLBACK_PATH}
# dengan body {request_id, stage, status, result, error_message}. URL kosong -> callback dilewati.
# ORCHESTRATION_API_KEY kosong = pakai API_KEY di atas.
# ORCHESTRATION_URL=http://host.docker.internal:8000
# ORCHESTRATION_CALLBACK_PATH=/v1/callbacks/stage
# ORCHESTRATION_API_KEY=
# ORCHESTRATION_TIMEOUT_SECONDS=10

# Callback dan handoff ke structuring dicoba ulang kalau tujuan tidak terjangkau / 5xx.
# PIPELINE_RETRY_ATTEMPTS=3
# PIPELINE_RETRY_DELAY_SECONDS=0.5
# PIPELINE_DRAIN_TIMEOUT_SECONDS=30

# Backend OCR:
#   remote  service model ekstraksi milik ML engineer (POST {url}/v1/predict/json, X-API-Key)
#   paddle  API lama service PaddleOCR (POST {url}/ocr, tanpa auth)
#   mock    baris NPWP deterministik, untuk test
# EKSTRAKSI_BACKEND=mock

# --- Backend remote ---
# API key dikirim ke SERVICE MODEL sebagai X-API-Key (beda dengan API_KEY di atas,
# yang dikirim pemanggil ke service ini). Dari dalam container, service di host
# dijangkau lewat host.docker.internal, bukan localhost.
# EKSTRAKSI_BACKEND=remote
# EKSTRAKSI_OCR_URL=http://localhost:8082
# EKSTRAKSI_OCR_API_KEY=dummy-key

# --- Backend paddle ---
# EKSTRAKSI_BACKEND=paddle
# EKSTRAKSI_OCR_URL=http://10.213.128.67:8070

# EKSTRAKSI_OCR_TIMEOUT_SECONDS=30

# Service lain. Pipeline async hanya memakai STRUCTURING_* (handoff ke tahap
# berikutnya); kontrak lama extract-ocr memakai ketiganya. Kalau *_API_KEY kosong,
# API_KEY di atas yang dipakai (praktis kalau keempat service memakai key yang sama).
# Menjalankan bare di host: 127.0.0.1:<port>. Di compose sudah di-override ke nama service.
GUARDRAILS_SERVICE_URL=http://127.0.0.1:8031
# GUARDRAILS_API_KEY=
# GUARDRAILS_TIMEOUT_SECONDS=10
STRUCTURING_SERVICE_URL=http://127.0.0.1:8032
# STRUCTURING_API_KEY=
# STRUCTURING_TIMEOUT_SECONDS=10
SCORING_SERVICE_URL=http://127.0.0.1:8033
# SCORING_API_KEY=
# SCORING_TIMEOUT_SECONDS=10

# Batas upload (berlaku untuk file maupun file_url).
# MAX_UPLOAD_BYTES=5242880
# ALLOWED_CONTENT_TYPES=["image/jpeg","image/jpg","image/png","application/pdf"]
