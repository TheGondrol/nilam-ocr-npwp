# Wajib. Key yang harus dikirim pemanggil (service structuring; ekstraksi untuk
# kontrak lama) lewat header X-API-Key.
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme

# Opsional: hanya mempengaruhi field 'servers' di OpenAPI (/docs).
# SERVICE_BASE_URL=http://your-vm-ip:8033
# PORT=8033

# Backend scorer (heuristic sampai model scoring tersedia).
# SCORING_BACKEND=heuristic

# Ambang batas keputusan approve/review/reject (hanya untuk field `decision`;
# orkestrator memakai ambang batasnya sendiri terhadap skor `guardrails`).
# SCORING_APPROVE_THRESHOLD=0.8
# SCORING_REVIEW_THRESHOLD=0.5

# --- Pipeline async (/v1/scoring/jobs), tahap terakhir ---
# Diisi -> scoring.jobs / scoring.results di PostgreSQL (jalankan db/schema.sql
# dulu). Kosong -> in-memory: cukup untuk dev satu proses, hilang saat restart,
# tidak idempoten antar replika.
# DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/bribrain_ocr_nilam

# Callback status tahap ke Orkestrasi: POST {ORCHESTRATION_URL}{ORCHESTRATION_CALLBACK_PATH}
# dengan body {request_id, stage, status, result, error_message}. Callback
# SCORING/DONE membawa hasil akhir di `result`. URL kosong -> callback dilewati.
# ORCHESTRATION_API_KEY kosong = pakai API_KEY di atas.
# ORCHESTRATION_URL=http://host.docker.internal:8000
# ORCHESTRATION_CALLBACK_PATH=/v1/callbacks/stage
# ORCHESTRATION_API_KEY=
# ORCHESTRATION_TIMEOUT_SECONDS=10

# Callback dicoba ulang kalau Orkestrasi tidak terjangkau / 5xx.
# PIPELINE_RETRY_ATTEMPTS=3
# PIPELINE_RETRY_DELAY_SECONDS=0.5
# PIPELINE_DRAIN_TIMEOUT_SECONDS=30
