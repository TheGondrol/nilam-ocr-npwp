# Konfigurasi tracker, di-source oleh run.sh dan stop.sh.
#
# Komentari SELURUH blok GKE di bawah untuk kembali ke stack lokal:
# app.py otomatis jatuh ke default 127.0.0.1:8030-8034 tanpa API key, dan
# callback datang langsung dari container seperti biasa. "Tanpa API key" berarti
# kelima service lokal (termasuk orchestrator) harus AUTH_DISABLED=true di .env-nya;
# kalau tidak, isi API_KEY di luar blok GKE dengan API_KEY service lokal.

# ── GKE: gc-ddb-dev-gke-cluster-01 / namespace nilam-ocr-npwp ────────────────
# TRACKER_TARGET=gke
# GKE_NAMESPACE=nilam-ocr-npwp
# Butuh chart 0.3.0+ (Deployment per service, termasuk orchestrator): port-forward ke svc/<GKE_RELEASE>-<service>.
# GKE_RELEASE=nilam-ocr-npwp
# ORCHESTRATOR_URL=http://127.0.0.1:9034
# GUARDRAILS_URL=http://127.0.0.1:9031
# EXTRACTION_URL=http://127.0.0.1:9030
# STRUCTURING_URL=http://127.0.0.1:9032
# SCORING_URL=http://127.0.0.1:9033
# API_KEY=changeme
# TRACKER_POLL=1
# ────────────────────────────────────────────────────────────────────────────

# Redis tetap lokal di kedua mode; tracker memakainya sebagai bus event.
REDIS_URL=redis://127.0.0.1:6379/0

# Pemantau outbox: tracker membaca pipeline_outbox dan <tahap>_jobs langsung dari
# PostgreSQL tiap 250 ms. Mode lokal: otomatis ke Postgres docker-compose.db.yml
# (127.0.0.1:${POSTGRES_HOST_PORT:-5433}). Mode GKE: isi sendiri kalau database
# dev bisa dijangkau dari laptop; kosong = panel outbox hanya bilang "tidak tersedia".
# TRACKER_DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5433/bribrain_ocr_nilam

# Sama dengan PIPELINE_WAIT_SECONDS di orchestrator; hanya untuk label di UI.
TRACKER_WAIT_SECONDS=15

# ── Skenario gangguan (mode lokal) ──
# Samakan dengan env service; lease pendek membuat skenario crash / database selesai dalam ~1 menit.
# TRACKER_JOB_LEASE_SECONDS=30
# TRACKER_STALE_JOB_INTERVAL_SECONDS=5
# TRACKER_DRAIN_SECONDS=30
# TRACKER_STOP_GRACE_SECONDS=45
# Callback format result (/v1/ocr-callback): periksa X-Callback-Key seperti Orkestrasi pusat.
# TRACKER_CALLBACK_KEY=local-callback-key
# TRACKER_CALLBACK_SLOW_SECONDS=12
# TRACKER_CALLBACK_FLAKY_FAILURES=2
