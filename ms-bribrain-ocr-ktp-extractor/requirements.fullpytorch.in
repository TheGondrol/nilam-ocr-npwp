# Runtime dependencies for the fullpytorch image (no paddle, no paddleocr).
# Torch + CUDA are supplied by the pytorch/pytorch base image and deliberately
# NOT pinned here so `uv pip install` leaves the pre-installed build alone.
#
# Regenerate the lock with:
#   uv pip compile requirements.fullpytorch.in \
#     -o requirements.fullpytorch.lock \
#     --python-version 3.11 --generate-hashes

