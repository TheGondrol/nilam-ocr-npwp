# syntax=docker/dockerfile:1.7
###############################################################################
# Lean fullpytorch-only image.
#
# No PaddlePaddle / PaddleOCR / paddlex — just torch + triton + autokernel +
# the vendored PaddleOCR2Pytorch PyTorch ports.
#
# Base: pytorch/pytorch official runtime (~5 GB) vs. paddlex base (~18 GB).
#
# Dependencies are pinned in requirements.fullpytorch.lock (generated from
# requirements.fullpytorch.in via `uv pip compile … --generate-hashes`).
# Regenerate with:
#   uv pip compile requirements.fullpytorch.in \
#     -o requirements.fullpytorch.lock \
#     --python-version 3.11 --generate-hashes
###############################################################################
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime AS base

# Pinned uv binary — bump together with the lockfile regeneration command.
COPY --from=ghcr.io/astral-sh/uv:0.9.24 /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_CACHE_DIR=/root/.cache/uv

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends \
      libgl1 libglib2.0-0 libgomp1 curl g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependency install — isolated in its own layer keyed only on the lockfile,
# so editing app code never re-runs resolution or downloads.
# `--no-deps` is safe (the lock is fully transitive & hashed) and `--system`
# targets the base image's conda Python, preserving the pre-installed torch.
COPY requirements.fullpytorch.lock /app/
RUN --mount=type=cache,target=${UV_CACHE_DIR} \
    uv pip install --system --no-deps --require-hashes \
        -r /app/requirements.fullpytorch.lock

# App code — ordered coldest → hottest so edits to src/ don't invalidate the
# heavier PaddleOCR2Pytorch / autokernel layers.
COPY PaddleOCR2Pytorch /app/PaddleOCR2Pytorch
COPY autokernel /app/autokernel
COPY config.yaml \
     PaddleOCR_server.yaml \
     PaddleOCR_mobile.yaml \
     PaddleOCR_hybrid.yaml \
     PaddleOCR_server_nohpi.yaml \
     main.py \
     /app/
COPY tests /app/tests
COPY src /app/src

# Allow non-root users to write runtime artifacts (logs, torch caches).
RUN mkdir -p /app/logs && chmod -R a+rwX /app

EXPOSE 8010

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8010/health/live || exit 1

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8010"]
