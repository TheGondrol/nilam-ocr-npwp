# Build context = root repo (Dockerfile tiap service butuh libs/ocr_common).
# Yang masuk image hanya libs/ocr_common dan services/<nama>/{requirements.txt,src}.
.git
.gitignore
.venv
**/.venv
**/.env
**/.env.example
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.ruff_cache
**/tests
**/openapi.yaml
**/pyproject.toml
!libs/ocr_common/pyproject.toml
**/Dockerfile
docker-compose*.yml
.dockerignore
Makefile
README.md
requirements-dev.txt
scripts
